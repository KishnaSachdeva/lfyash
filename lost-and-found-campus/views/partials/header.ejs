<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="EduPortaile - Lost and Found platform for Chitkara University campus">
  <title><%= title %></title>

  <!-- Google Fonts - Poppins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Socket.io Client -->
  <script src="https://cdn.socket.io/4.6.1/socket.io.min.js"></script>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-logo">
        <span class="logo-icon">📍</span>
        <span class="logo-text">EduPortaile</span>
      </a>

      <div class="nav-links">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="nav-link">Dashboard</a>
          <a href="/items" class="nav-link">Browse Items</a>
          <a href="/report" class="nav-link nav-btn">Report Item</a>

          <!-- Notifications Bell -->
          <div class="notification-dropdown">
            <button class="notification-btn" id="notificationBtn">
              <span class="bell-icon">🔔</span>
              <span class="notification-badge" id="notificationBadge" style="display: none;">0</span>
            </button>
            <div class="notification-content" id="notificationContent">
              <div class="notification-header">
                <h4>Notifications</h4>
                <button class="mark-read-btn" id="markReadBtn">Mark all read</button>
              </div>
              <div class="notification-list" id="notificationList">
                <p class="no-notifications">No notifications</p>
              </div>
            </div>
          </div>

          <!-- User Menu -->
          <div class="user-menu">
            <span class="user-name"><%= user.name %></span>
            <form action="/api/auth/logout" method="POST" class="logout-form" onsubmit="return confirm('Are you sure you want to logout?')">
              <button type="submit" class="logout-btn">Logout</button>
            </form>
          </div>
        <% } else { %>
          <a href="/items" class="nav-link">Browse</a>
          <a href="/login" class="nav-link">Login</a>
          <a href="/register" class="nav-link nav-btn">Register</a>
        <% } %>
      </div>

      <!-- Mobile Menu Toggle -->
      <button class="mobile-menu-toggle" id="mobileMenuToggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/dashboard" class="mobile-link">Dashboard</a>
      <a href="/items" class="mobile-link">Browse Items</a>
      <a href="/report" class="mobile-link">Report Item</a>
      <form action="/api/auth/logout" method="POST" class="mobile-link logout" style="display: inline;" onsubmit="return confirm('Are you sure you want to logout?')">
        <button type="submit" style="background: none; border: none; color: inherit; font: inherit; cursor: pointer; width: 100%; text-align: left;">Logout</button>
      </form>
    <% } else { %>
      <a href="/items" class="mobile-link">Browse</a>
      <a href="/login" class="mobile-link">Login</a>
      <a href="/register" class="mobile-link">Register</a>
    <% } %>
  </div>

  <!-- Flash Messages Container -->
  <div id="flashMessages" class="flash-messages"></div>
