<%- include('partials/header') %>

<!-- Auth Container -->
<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <h1>Welcome Back</h1>
      <p>Sign in to continue to EduPortaile</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error">
        <span class="alert-icon">⚠️</span>
        <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success">
        <span class="alert-icon">✅</span>
        <%= success %>
      </div>
    <% } %>

    <!-- Login Form -->
    <form class="auth-form" id="loginForm" action="/api/auth/login" method="POST">
      <div class="form-group">
        <label for="email">College Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="your.name@chitkara.edu.in"
          required
          pattern="[\w.+-]+@chitkara\.edu\.in"
          title="Please use your @chitkara.edu.in email address"
        >
        <span class="form-hint">Use your @chitkara.edu.in email</span>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Enter your password"
          required
          minlength="6"
        >
      </div>

      <button type="submit" class="btn btn-primary btn-block">
        Send Login OTP
      </button>
    </form>

    <!-- OTP Verification Form (hidden initially) -->
    <form class="auth-form otp-form" id="otpForm" action="/api/auth/login-otp" method="POST" style="display: none;">
      <input type="hidden" name="userId" id="otpUserId">

      <div class="otp-header">
        <span class="otp-icon">📧</span>
        <h3>Enter Verification Code</h3>
        <p>We've sent a 4-digit OTP to your email</p>
      </div>

      <div class="form-group">
        <label for="otp">OTP Code</label>
        <input
          type="text"
          id="otp"
          name="otp"
          placeholder="Enter 4-digit OTP"
          maxlength="4"
          pattern="[0-9]{4}"
          required
          class="otp-input"
        >
      </div>

      <button type="submit" class="btn btn-primary btn-block">
        Verify & Login
      </button>

      <button type="button" class="btn btn-link btn-block" id="resendOtpBtn">
        Resend OTP
      </button>
    </form>

    <div class="auth-footer">
      <p>Don't have an account? <a href="/register">Register here</a></p>
    </div>
  </div>
</div>

<script>
  // Handle login form submission
  document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const form = e.target;
    const submitBtn = form.querySelector('button[type="submit"]');

    // Get form values
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;

    // Client-side validation
    if (!email) {
      showFlashMessage('Please enter your email', 'error');
      return;
    }
    if (!password) {
      showFlashMessage('Please enter your password', 'error');
      return;
    }

    try {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending OTP...';

      const response = await fetch(form.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ email, password }),
      });

      const data = await response.json();

      if (data.success) {
        // Show OTP form
        document.getElementById('otpUserId').value = data.userId;
        document.getElementById('loginForm').style.display = 'none';
        document.getElementById('otpForm').style.display = 'block';

        // Show success message
        showFlashMessage('OTP sent to your email!', 'success');
      } else {
        showFlashMessage(data.message || 'Login failed', 'error');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Login OTP';
      }
    } catch (error) {
      showFlashMessage('Network error. Please try again.', 'error');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Login OTP';
    }
  });

  // Handle OTP form submission
  document.getElementById('otpForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const form = e.target;
    const userId = document.getElementById('otpUserId').value;
    const otp = document.getElementById('otp').value.trim();
    const submitBtn = form.querySelector('button[type="submit"]');

    // Client-side validation
    if (!userId) {
      showFlashMessage('User ID missing. Please restart login.', 'error');
      return;
    }
    if (!otp || otp.length !== 4) {
      showFlashMessage('Please enter a valid 4-digit OTP', 'error');
      return;
    }

    try {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Verifying...';

      const response = await fetch(form.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ userId, otp }),
      });

      const data = await response.json();

      if (data.success) {
        // Store token and redirect
        document.cookie = `token=${data.token}; path=/; max-age=${7 * 24 * 60 * 60}`;
        showFlashMessage('Login successful! Redirecting...', 'success');
        setTimeout(() => {
          window.location.href = '/dashboard';
        }, 1000);
      } else {
        showFlashMessage(data.message || 'Invalid OTP', 'error');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Verify & Login';
      }
    } catch (error) {
      showFlashMessage('Network error. Please try again.', 'error');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Verify & Login';
    }
  });

  // Resend OTP
  document.getElementById('resendOtpBtn').addEventListener('click', async () => {
    const userId = document.getElementById('otpUserId').value;

    if (!userId) {
      showFlashMessage('User ID missing. Please restart login.', 'error');
      return;
    }

    try {
      const response = await fetch('/api/auth/resend-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId }),
      });

      const data = await response.json();

      if (data.success) {
        showFlashMessage('OTP resent to your email!', 'success');
      } else {
        showFlashMessage(data.message || 'Failed to resend OTP', 'error');
      }
    } catch (error) {
      showFlashMessage('Network error. Please try again.', 'error');
    }
  });
</script>

<%- include('partials/footer') %>
