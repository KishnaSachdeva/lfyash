/**
 * EduPortaile - Professional SaaS Dashboard Styles
 * Dark Glassmorphism Design Language
 */

/* ==========================================
   CSS VARIABLES (Custom Properties)
   ========================================== */
:root {
  /* Professional SaaS Color Palette */
  --primary-color: #4F7DF3;
  --primary-dark: #3b6be0;
  --primary-light: #7c99ff;

  --bg-primary: #0A0A0A;
  --bg-secondary: #121829;
  --bg-card: #121829;
  --bg-input: #1c233d;

  --text-primary: #FFFFFF;
  --text-secondary: #A0A0A0;
  --text-muted: #666666;

  --success-color: #22C55E;
  --warning-color: #F59E0B;
  --error-color: #EF4444;

  --border-color: #242d4a;
  --border-light: #323c5e;

  /* Spacing & Radius */
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;
  --spacing-2xl: 48px;

  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-full: 9999px;

  /* Effects */
  --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.5);
  --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.6);
  --shadow-glow: 0 0 20px rgba(79, 125, 243, 0.2);

  --transition-base: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ==========================================
   RESET & BASE STYLES
   ========================================== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Poppins', sans-serif;
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.6;
  min-height: 100vh;
}

a {
  text-decoration: none;
  color: inherit;
}

/* ==========================================
   NAVIGATION (Modern SaaS Style)
   ========================================== */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(10, 10, 10, 0.8);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-color);
  height: 64px;
  display: flex;
  align-items: center;
}

.nav-container {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 var(--spacing-lg);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--text-primary);
}

/* Search Bar */
.nav-search {
  position: relative;
  flex: 0 1 400px;
  margin: 0 var(--spacing-xl);
}

.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 12px;
  color: var(--text-secondary);
  font-size: 1.1rem;
  pointer-events: none;
}

.search-input {
  width: 100%;
  padding: 10px 16px 10px 40px;
  background: var(--bg-input);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  font-size: 0.9rem;
  transition: all var(--transition-base);
}

.search-input:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(79, 125, 243, 0.2);
}

/* Right Actions */
.nav-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.notification-btn {
  background: transparent;
  border: none;
  color: var(--text-secondary);
  font-size: 1.4rem;
  cursor: pointer;
  position: relative;
  padding: 8px;
  border-radius: 50%;
  transition: background var(--transition-base);
}

.notification-btn:hover {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-primary);
}

.notification-badge {
  position: absolute;
  top: 4px;
  right: 4px;
  background: var(--error-color);
  color: white;
  font-size: 0.6rem;
  padding: 2px 5px;
  border-radius: var(--radius-full);
}

/* Profile Dropdown */
.user-profile {
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  border-radius: var(--radius-md);
  transition: background var(--transition-base);
  user-select: none;
}

.user-profile:hover {
  background: rgba(255, 255, 255, 0.05);
}

.user-profile-name {
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--text-primary);
}

.profile-dropdown {
  position: absolute;
  top: 55px;
  right: 0;
  width: 200px;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  display: none;
  flex-direction: column;
  padding: 8px;
  z-index: 1100;
}

.profile-dropdown.active {
  display: flex;
}

.dropdown-item {
  padding: 10px 16px;
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 0.9rem;
  border-radius: var(--radius-sm);
  transition: all var(--transition-base);
}

.dropdown-item:hover {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-primary);
}

.dropdown-item.logout {
  color: var(--error-color);
  border-top: 1px solid var(--border-color);
  margin-top: 8px;
  padding-top: 12px;
}

/* ==========================================
   SIDEBAR (Modern Professional)
   ========================================== */
.dashboard-container {
  display: grid;
  grid-template-columns: 240px 1fr;
  margin-top: 64px;
}

.dashboard-sidebar {
  background: var(--bg-primary);
  border-right: 1px solid var(--border-color);
  padding: var(--spacing-lg);
  height: calc(100vh - 64px);
  position: sticky;
  top: 64px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sidebar-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 16px;
  color: var(--text-secondary);
  text-decoration: none;
  border-radius: var(--radius-md);
  font-size: 0.95rem;
  font-weight: 500;
  transition: all var(--transition-base);
}

.sidebar-link:hover {
  background: rgba(255, 255, 255, 0.05);
  padding-left: 20px;
  color: var(--text-primary);
}

.sidebar-link.active {
  background: rgba(79, 125, 243, 0.15);
  color: var(--primary-color);
  box-shadow: inset 0 0 0 1px rgba(79, 125, 243, 0.3);
}

.logout-section {
  border-top: 1px solid var(--border-color);
  padding-top: var(--spacing-md);
}

.logout-btn-dark {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  background: transparent;
  border: none;
  color: var(--text-secondary);
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  border-radius: var(--radius-md);
  transition: all var(--transition-base);
  text-align: left;
}

.logout-btn-dark:hover {
  background: rgba(239, 68, 68, 0.1);
  color: var(--error-color);
}

/* ==========================================
   DASHBOARD MAIN
   ========================================== */
.dashboard-main {
  padding: var(--spacing-xl);
  background: var(--bg-primary);
}

.dashboard-title-section {
  margin-bottom: var(--spacing-xl);
}

.dashboard-label {
  font-size: 0.85rem;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 4px;
  display: block;
}

.welcome-text {
  font-size: 2rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.dashboard-subtitle {
  font-size: 1rem;
  color: var(--text-muted);
}

/* Stats Cards */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--spacing-lg);
  margin-bottom: var(--spacing-xl);
}

.stat-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  transition: all var(--transition-base);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  cursor: default;
}

.stat-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-glow);
  border-color: var(--primary-color);
}

.stat-card-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: var(--spacing-md);
}

.stat-card-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
}

.icon-blue { background: rgba(79, 125, 243, 0.15); color: var(--primary-color); }
.icon-orange { background: rgba(245, 158, 11, 0.15); color: var(--warning-color); }
.icon-green { background: rgba(34, 197, 94, 0.15); color: var(--success-color); }
.icon-purple { background: rgba(168, 85, 247, 0.15); color: #a855f7; }

.stat-title {
  font-size: 0.9rem;
  color: var(--text-secondary);
  font-weight: 500;
}

.stat-value {
  font-size: 2rem;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-desc {
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* Recent Items Section */
.dashboard-section {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.section-header h2 {
  font-size: 1.2rem;
  font-weight: 600;
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 80px 40px;
}

.empty-icon {
  font-size: 4rem;
  margin-bottom: var(--spacing-md);
  display: block;
}

.empty-state h3 {
  font-size: 1.5rem;
  margin-bottom: var(--spacing-sm);
}

.empty-state p {
  color: var(--text-secondary);
  margin-bottom: var(--spacing-xl);
  max-width: 400px;
  margin-left: auto;
  margin-right: auto;
}

.empty-actions {
  display: flex;
  gap: var(--spacing-md);
  justify-content: center;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 20px;
  border: none;
  border-radius: var(--radius-md);
  font-size: 0.95rem;
  font-weight: 500;
  text-decoration: none;
  transition: all var(--transition-base);
  cursor: pointer;
}

.btn-primary {
  background: var(--primary-color);
  color: white;
  transition: all var(--transition-base);
}

.btn-primary:hover {
  background: var(--primary-dark);
  transform: scale(1.03);
}

.btn-secondary {
  background: var(--bg-input);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
  transition: all var(--transition-base);
}

.btn-secondary:hover {
  background: #242d4a;
  border-color: var(--primary-color);
  transform: scale(1.03);
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 968px) {
  .dashboard-container {
    grid-template-columns: 1fr;
  }
  .dashboard-sidebar {
    display: none;
  }
}
